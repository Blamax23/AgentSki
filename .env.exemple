# Modèle de configuration : copie ce fichier en .env et remplis-le. Le vrai .env n'est JAMAIS dans git.

# --- Obligatoire ---
TELEGRAM_BOT_TOKEN=            # BotFather
OPENROUTER_API_KEY=            # clé plafonnée, ZDR activé sur les groupes de modèles
ALLOWED_USERS=123456789:Maxime # identifiant Telegram:prénom de l'organisateur (les amis passent par la question d'accès)

# --- Question d'accès pour les amis (sans réponse, les inconnus sont ignorés) ---
QUESTION_ACCES=
REPONSE_ACCES=

# --- Facultatif ---
AGENDA_ICAL_URL=               # lien iCal privé en lecture de l'agenda de l'organisateur
SPOTIFY_CLIENT_ID=             # application Spotify (compte Premium) ; puis scripts/spotify_autoriser.py écrit le jeton
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
DATABASE_PATH=data/agentski.db
YOUTUBE_API_KEY=             # clé Google (YouTube Data API v3) pour /vues
